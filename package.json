{
  "name": "pdf-studio",
  "version": "1.0.0",
  "private": true,
  "description": "تطبيق ويب وأندرويد (APK) محلي لدمج وتعديل ملفات PDF بخصوصية كاملة ودون إنترنت",
  "scripts": {
    "copy:pdf-worker": "node scripts/copy-pdf-worker.mjs",
    "predev": "npm run copy:pdf-worker",
    "dev": "next dev",
    "prebuild": "npm run copy:pdf-worker",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "generate:samples": "node scripts/generate-test-samples.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "android:init": "npm run build && npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:copy": "npm run build && npx cap copy android",
    "android:open": "npx cap open android",
    "android:doctor": "npx cap doctor android",
    "android:assets": "npx capacitor-assets generate --android",
    "android:configure": "node scripts/configure-android-phase3.mjs",
    "android:prepare": "npm run build && npx cap sync android && npm run android:configure && npm run android:configure-signing && npm run android:assets",
    "android:configure-signing": "node scripts/configure-android-signing.mjs",
    "android:keystore": "node scripts/create-keystore.mjs",
    "android:apk:debug": "node scripts/build-android.mjs debug",
    "android:apk:release": "node scripts/build-android.mjs release-apk",
    "android:aab:release": "node scripts/build-android.mjs release-aab"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/share": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "lucide-react": "^0.468.0",
    "next": "14.2.25",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3",
    "@capacitor/splash-screen": "^6.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.25",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
